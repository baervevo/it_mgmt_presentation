FROM debian:12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ansible \
        git \
        curl \
        openssh-client \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV ANSIBLE_CONFIG=/root/workspace/ansible.cfg \
    ANSIBLE_HOST_KEY_CHECKING=False

COPY lab-repo.bundle /opt/lab-repo.bundle
COPY bin/ /usr/local/bin/
RUN chmod +x /usr/local/bin/lab-*

COPY control-entry.sh /control-entry.sh
RUN chmod +x /control-entry.sh

WORKDIR /root/workspace
CMD ["/control-entry.sh"]
